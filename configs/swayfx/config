# Solid Dark / Subtle FX — minimal, professional, developer-focused.
# Every visual knob for the whole desktop lives in this one block. Change a
# value here and reload ($mod+Shift+c); Waybar/Wofi/Mako/Swaylock/Alacritty
# intentionally ship with matching (not identical) hardcoded copies of this
# same palette, since they can't read Sway variables directly.
set $mod Mod4
set $terminal alacritty
set $launcher wofi --show drun --allow-images
set $config ~/.config/swayfx/config

# --- Keyboard layout ---------------------------------------------------------
# Filled in at install time by the installer (default: AZERTY/fr).
input * {
    xkb_layout "{{XKB_LAYOUT}}"
    xkb_variant "{{XKB_VARIANT}}"
}

# --- Palette: Solid Dark / Subtle FX ---------------------------------------
set $bg          #0b111a
set $bg_surface  #121a26
set $accent      #69a7ff
set $secondary   #273344
set $text        #d6deea
set $muted_text  #7d90ab
set $urgent      #e6a567

set $focused   $accent
set $unfocused $secondary

# --- Layout: gaps & borders --------------------------------------------------
set $border_width 2
set $gap_inner 8
set $gap_outer 8

include ~/.config/swayfx/outputs.conf

# --- FX: corner radius, shadow, blur, animation, dim -------------------------
set $corner_radius 8
set $shadow_blur_radius 12
set $shadow_color #00000066
set $blur_radius 3
set $blur_passes 2
set $dim_inactive 0.12
set $animation_duration_ms 150

font pango:JetBrainsMono Nerd Font Mono 10
floating_modifier $mod normal
default_border pixel $border_width
default_floating_border pixel $border_width
gaps inner $gap_inner
gaps outer $gap_outer
smart_gaps on
smart_borders on

client.focused $accent $bg $accent $accent $accent
client.unfocused $secondary $bg $secondary $secondary $secondary
client.urgent $urgent $bg $urgent $urgent $urgent

corner_radius $corner_radius
shadows enable
shadow_blur_radius $shadow_blur_radius
shadow_color $shadow_color
# Windows stay opaque by default; blur is opt-in and kept minimal on purpose.
blur disable
blur_radius $blur_radius
blur_passes $blur_passes
default_dim_inactive $dim_inactive

# Subtle FX on the panels/launcher/notifications too, kept light so nothing
# reads as "glassy". Panels stay opaque; this only rounds/softens their edges.
layer_effects "waybar" {
    corner_radius $corner_radius
    shadows enable
}
layer_effects "wofi" {
    corner_radius $corner_radius
    shadows enable
}
layer_effects "notifications" {
    corner_radius $corner_radius
    shadows enable
}

exec_always --no-startup-id ~/.config/swayfx/scripts/wallpaper.sh
exec --no-startup-id waybar
exec --no-startup-id mako
exec --no-startup-id swayidle -w timeout 300 '~/.config/swayfx/scripts/lock.sh' timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' before-sleep '~/.config/swayfx/scripts/lock.sh'

bindsym $mod+Return exec $terminal
bindsym $mod+d exec $launcher
bindsym $mod+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec ~/.config/swayfx/scripts/power-menu.sh
bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle
bindsym $mod+w exec ~/.config/swayfx/scripts/wallpaper-manager.sh
bindsym $mod+Shift+f exec ~/.config/swayfx/scripts/font-manager.py
bindsym $mod+Ctrl+l exec ~/.config/swayfx/scripts/lock.sh
bindsym Print exec ~/.config/swayfx/scripts/screenshot.sh full
bindsym Shift+Print exec ~/.config/swayfx/scripts/screenshot.sh area

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
# Keycodes keep the physical number row consistent across keyboard layouts.
bindcode $mod+10 workspace $ws1
bindcode $mod+11 workspace $ws2
bindcode $mod+12 workspace $ws3
bindcode $mod+13 workspace $ws4
bindcode $mod+14 workspace $ws5
bindcode $mod+15 workspace $ws6
bindcode $mod+16 workspace $ws7
bindcode $mod+17 workspace $ws8
bindcode $mod+18 workspace $ws9
bindcode $mod+Shift+10 move container to workspace $ws1
bindcode $mod+Shift+11 move container to workspace $ws2
bindcode $mod+Shift+12 move container to workspace $ws3
bindcode $mod+Shift+13 move container to workspace $ws4
bindcode $mod+Shift+14 move container to workspace $ws5
bindcode $mod+Shift+15 move container to workspace $ws6
bindcode $mod+Shift+16 move container to workspace $ws7
bindcode $mod+Shift+17 move container to workspace $ws8
bindcode $mod+Shift+18 move container to workspace $ws9

bindsym $mod+Shift+q exec ~/.config/swayfx/scripts/power-menu.sh
include /etc/sway/config.d/*
